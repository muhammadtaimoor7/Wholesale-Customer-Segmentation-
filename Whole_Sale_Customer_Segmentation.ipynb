    {
      "cell_type": "code",
      "source": [
        "#Step 6\n",
        "#Select Related Cols\n",
        "X=df[['Fresh', 'Milk', 'Grocery', 'Frozen', 'Detergents_Paper', 'Delicassen']]"
      ],
      "metadata": {
        "id": "INHABBK3WrpP"
      },
      "execution_count": 89,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 7\n",
        "#Feature Scaling\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "sc=StandardScaler()\n",
        "X_scaled=sc.fit_transform(X)"
      ],
      "metadata": {
        "id": "B7CZQXxkXEwT"
      },
      "execution_count": 90,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 8\n",
        "#Elbow Method\n",
        "inertia=[]\n",
        "K_range=range(1,11)\n",
        "for k in K_range:\n",
        "  KMeans_model=KMeans(n_clusters=k,random_state=42)\n",
        "  KMeans_model.fit(X)\n",
        "  inertia.append(KMeans_model.inertia_)\n"
      ],
      "metadata": {
        "id": "IjlKQI94XrPJ"
      },
      "execution_count": 91,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#Step 9\n",
        "#Plot curve\n",
        "plt.plot(K_range,inertia,marker=\"o\")\n",
        "plt.title(\"Elbow Method\")\n",
        "plt.xlabel(\"Number of Clusters\")\n",
        "plt.ylabel(\"Inertia\")\n",
        "plt.show()"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 472
